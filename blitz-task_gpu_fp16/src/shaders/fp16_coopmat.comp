// Cooperative-matrix fp16 kernel — SOURCE FORM for the Vulkan tensor path.
// One subgroup collaborates on a 16x16x16 {f16,f16,f32} cooperative matrix MMA;
// each subgroup runs `iters` dependent MMAs. Every A/B element is the exact half
// 1/16 and the accumulator starts at 0, so every C element equals
// iters*16*(1/16)^2 exactly (uniform matrix product), matching
// kernel_params.hpp::tensor_out(iters, 16). Output is written as f32.
//
// Compiled ONLY when glslang advertises GL_KHR_cooperative_matrix (SDK
// >= 1.3.261 / glslang >= 13); the shaders/ CMake probes this and otherwise
// embeds the packed kernel alone. Compile with --target-env vulkan1.3.
//
//   glslangValidator -V --target-env vulkan1.3 fp16_coopmat.comp -o fp16_coopmat.spv

#version 450 core
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) writeonly buffer Out { float outv[]; };

// n is unused here (all launched invocations participate — coopmat ops require
// subgroup-uniform control flow, so no early return). iters/mf/af mirror the
// packed kernel's push-constant layout so the host uses one struct.
layout(push_constant) uniform PC { uint n; uint iters; float mf; float af; } pc;

void main() {
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>(float16_t(0.0625));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>(float16_t(0.0625));
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (uint i = 0u; i < pc.iters; ++i)
        c = coopMatMulAdd(a, b, c);

    // Every element is identical; store this invocation's component 0.
    outv[gl_GlobalInvocationID.x] = float(c[0]);
}
