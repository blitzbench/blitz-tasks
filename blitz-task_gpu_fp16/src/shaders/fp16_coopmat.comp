// Cooperative-matrix fp16 kernel — SOURCE FORM for the Vulkan tensor path.
// Each subgroup runs `iters` MxNxK {f16,f16,f32} cooperative matrix MMAs, split
// over four independent accumulators so the matrix pipe never waits on the
// previous result. M/N/K are specialization constants: the host picks a shape
// the device lists (16x16x16 on NVIDIA/AMD, 8x8x16 on Intel, ...).
//
// Every A/B element is the exact half 1/16, passed in as pc.af rather than written
// as a literal so no compiler can fold the products, and the accumulators start at 0, so
// summed over the chains every C element equals iters*K*(1/16)^2 exactly,
// matching kernel_params.hpp::tensor_out(iters, K). Every element is consumed so
// no MMA can be dropped as dead code. The first invocation of each workgroup adds
// the workgroup's subgroup count to `subgroups`, so the host counts the work
// exactly whatever subgroup width the driver picked for this pipeline.
//
// Compiled ONLY when glslang advertises GL_KHR_cooperative_matrix (SDK
// >= 1.3.261 / glslang >= 13); the shaders/ CMake probes this and otherwise
// embeds the packed kernel alone. Compile with --target-env vulkan1.3.
//
//   glslangValidator -V --target-env vulkan1.3 fp16_coopmat.comp -o fp16_coopmat.spv

#version 450 core
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(constant_id = 0) const uint kM = 16;
layout(constant_id = 1) const uint kN = 16;
layout(constant_id = 2) const uint kK = 16;

layout(set = 0, binding = 0, std430) writeonly buffer Out { float outv[]; };
layout(set = 0, binding = 1, std430) buffer Count { uint subgroups; };

// n and mf are unused here (all launched invocations participate — coopmat ops
// require subgroup-uniform control flow, so no early return). The layout mirrors
// the packed kernel's push constants so the host uses one struct.
layout(push_constant) uniform PC { uint n; uint iters; float mf; float af; } pc;

#define ACC coopmat<float, gl_ScopeSubgroup, kM, kN, gl_MatrixUseAccumulator>

void main() {
    const coopmat<float16_t, gl_ScopeSubgroup, kM, kK, gl_MatrixUseA> a =
        coopmat<float16_t, gl_ScopeSubgroup, kM, kK, gl_MatrixUseA>(float16_t(pc.af));
    const coopmat<float16_t, gl_ScopeSubgroup, kK, kN, gl_MatrixUseB> b =
        coopmat<float16_t, gl_ScopeSubgroup, kK, kN, gl_MatrixUseB>(float16_t(pc.af));
    ACC c0 = ACC(0.0);
    ACC c1 = ACC(0.0);
    ACC c2 = ACC(0.0);
    ACC c3 = ACC(0.0);

    for (uint i = 0u; i < pc.iters / 4u; ++i) {
        c0 = coopMatMulAdd(a, b, c0);
        c1 = coopMatMulAdd(a, b, c1);
        c2 = coopMatMulAdd(a, b, c2);
        c3 = coopMatMulAdd(a, b, c3);
    }

    float s = 0.0;
    for (uint j = 0u; j < uint(c0.length()); ++j) s += c0[j] + c1[j] + c2[j] + c3[j];
    outv[gl_GlobalInvocationID.x] = s / float(c0.length());

    if (gl_LocalInvocationIndex == 0u) atomicAdd(subgroups, gl_NumSubgroups);
}
