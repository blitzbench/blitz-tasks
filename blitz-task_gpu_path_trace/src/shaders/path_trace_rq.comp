#version 460
// Path tracer using ray queries (VK_KHR_ray_query) against the driver built acceleration structure, which runs on the
// ray tracing hardware where the GPU has it.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require

#include "path_trace_common.glsl"

layout(set = 0, binding = 9) uniform accelerationStructureEXT tlas;

bool trace_closest(vec3 origin, vec3 dir, out Hit hit) {
  rayQueryEXT q;
  rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.0, dir, kInfinity);
  while (rayQueryProceedEXT(q)) {
  }
  if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionTriangleEXT) return false;
  hit.t = rayQueryGetIntersectionTEXT(q, true);
  hit.mesh = uint(rayQueryGetIntersectionGeometryIndexEXT(q, true));
  hit.prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
  hit.bary = rayQueryGetIntersectionBarycentricsEXT(q, true);
  return true;
}

bool trace_occluded(vec3 origin, vec3 dir) {
  rayQueryEXT q;
  rayQueryInitializeEXT(q, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF, origin, 0.0, dir,
                        kInfinity);
  while (rayQueryProceedEXT(q)) {
  }
  return rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

#include "path_trace_main.glsl"
