// Cooperative-matrix int8 tensor kernel (Vulkan) — SOURCE FORM. Each subgroup
// runs `iters` MxNxK {s8,s8,s32} cooperative matrix MMAs, split over four
// independent accumulators so the matrix pipe never waits on the previous result.
// M/N/K are specialization constants: the host picks a shape the device lists
// (16x16x32 on NVIDIA, 16x16x16 on AMD, 8x8x32 on Intel, ...).
//
// A and B are all ones, read from pc.one rather than written as a literal so no
// compiler can fold the products. Summed over the chains every C element ends at
// K*iters (bench::i8::reference_tensor) regardless of lane layout, so the result
// is exactly verifiable. Every element is consumed so no MMA can be dropped as
// dead code. The first invocation of each workgroup adds the workgroup's subgroup
// count to `subgroups`, so the host counts the work exactly whatever subgroup
// width the driver picked for this pipeline.
//
// Requires VK_KHR_cooperative_matrix + shaderInt8 + the Vulkan memory model,
// checked on the host before this path is selected. glslang >= 13 (Vulkan SDK
// >= 1.3.261) is needed to compile; the shader is only embedded when the
// configure-time probe passes.
//
//   glslangValidator -V --target-env vulkan1.3 int8_coopmat.comp -o int8_coopmat.spv

#version 450
#extension GL_KHR_cooperative_matrix        : require
#extension GL_KHR_memory_scope_semantics    : require
#extension GL_KHR_shader_subgroup_basic     : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8  : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

layout(local_size_x = 256) in;

layout(constant_id = 0) const uint kM = 16;
layout(constant_id = 1) const uint kN = 16;
layout(constant_id = 2) const uint kK = 16;

layout(set = 0, binding = 0, std430) writeonly buffer Out { uint outv[]; };
layout(set = 0, binding = 1, std430) buffer Count { uint subgroups; };

layout(push_constant) uniform PC { uint n; uint iters; int one; } pc;

#define ACC coopmat<int32_t, gl_ScopeSubgroup, kM, kN, gl_MatrixUseAccumulator>

void main() {
    const coopmat<int8_t, gl_ScopeSubgroup, kM, kK, gl_MatrixUseA> a =
        coopmat<int8_t, gl_ScopeSubgroup, kM, kK, gl_MatrixUseA>(int8_t(pc.one));
    const coopmat<int8_t, gl_ScopeSubgroup, kK, kN, gl_MatrixUseB> b =
        coopmat<int8_t, gl_ScopeSubgroup, kK, kN, gl_MatrixUseB>(int8_t(pc.one));
    ACC c0 = ACC(0);
    ACC c1 = ACC(0);
    ACC c2 = ACC(0);
    ACC c3 = ACC(0);

    for (uint i = 0u; i < pc.iters / 4u; ++i) {
        c0 = coopMatMulAdd(a, b, c0);
        c1 = coopMatMulAdd(a, b, c1);
        c2 = coopMatMulAdd(a, b, c2);
        c3 = coopMatMulAdd(a, b, c3);
    }

    uint s = 0u;
    for (uint j = 0u; j < uint(c0.length()); ++j) s += uint(c0[j] + c1[j] + c2[j] + c3[j]);

    uint t = gl_GlobalInvocationID.x;
    if (t < pc.n) outv[t] = s / uint(c0.length());

    if (gl_LocalInvocationIndex == 0u) atomicAdd(subgroups, gl_NumSubgroups);
}
