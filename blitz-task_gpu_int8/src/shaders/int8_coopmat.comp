// Cooperative-matrix int8 tensor kernel (Vulkan) — SOURCE FORM. One subgroup
// computes a 16x16x16 {s8,s8,s32} MMA and accumulates it `iters` times. A and B
// are all-ones s8, so every accumulator element ends at 16*iters
// (bench::i8::reference_tensor) regardless of lane layout — exactly verifiable.
//
// Requires VK_KHR_cooperative_matrix + shaderInt8 + a {s8,s8,s32,16,16,16,
// scope=subgroup} config, all checked on the host before this path is selected.
// Assumes a subgroup size of 32 (local_size_x); the host requests a matching
// required-subgroup-size where supported.
//
// CI NOTE: cooperative-matrix hardware is unavailable on the dev box; this path
// is validated on NVIDIA/AMD CI. glslang >= 13 (Vulkan SDK >= 1.3.261) required
// to compile — the shader is only embedded when the configure-time probe passes.
//
//   glslangValidator -V --target-env vulkan1.3 int8_coopmat.comp -o int8_coopmat.spv

#version 450
#extension GL_KHR_cooperative_matrix        : require
#extension GL_KHR_memory_scope_semantics    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8  : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

layout(local_size_x = 32) in;

layout(set = 0, binding = 0, std430) writeonly buffer Out { int outv[]; };

layout(push_constant) uniform PC { uint n; uint iters; } pc;

void main() {
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a =
        coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>(int8_t(1));
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b =
        coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>(int8_t(1));
    coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c =
        coopmat<int32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);

    for (uint i = 0u; i < pc.iters; ++i)
        c = coopMatMulAdd(a, b, c);

    // Every held element equals 16*iters; publish it for verification / anti-DCE.
    uint t = gl_GlobalInvocationID.x;
    if (t < pc.n) outv[t] = c[0];
}
