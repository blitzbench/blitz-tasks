// Cooperative-matrix fp16 GEMM — SOURCE FORM for the Vulkan tensor path.
// C = A * B for square row-major matrices, using MxNxK {f16,f16,f32}
// cooperative matrices: one subgroup accumulates one MxN output tile at a time,
// walking the full K dimension. Operands are loaded straight from global memory,
// which keeps the kernel short at the cost of leaning on the cache hierarchy —
// this path exists to represent what the Vulkan ecosystem delivers without a
// vendor BLAS, not to compete with one.
//
// M/N/K are specialization constants: the host picks a shape the device lists
// (16x16x16 on NVIDIA/AMD, 8x8x16 on Intel, ...). Each workgroup owns a fixed
// block of kTilesPerGroup output tiles and its subgroups stride over that block,
// so every tile is computed exactly once whatever subgroup width the driver
// picks, even if that width differs between workgroups.
//
// Compiled ONLY when glslang advertises GL_KHR_cooperative_matrix (SDK
// >= 1.3.261 / glslang >= 13); the shaders/ CMake probes this and otherwise
// embeds the tiled kernel alone. Compile with --target-env vulkan1.3.
//
//   glslangValidator -V --target-env vulkan1.3 gemm_coopmat.comp -o gemm_coopmat.spv

#version 450 core
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint kM = 16;
layout(constant_id = 1) const uint kN = 16;
layout(constant_id = 2) const uint kK = 16;

// Must match kCoopTilesPerGroup in the Vulkan runner, which sizes the dispatch.
const uint kTilesPerGroup = 16u;

layout(set = 0, binding = 0, std430) readonly buffer BufA { float16_t a[]; };
layout(set = 0, binding = 1, std430) readonly buffer BufB { float16_t b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer BufC { float c[]; };

layout(push_constant) uniform PC { uint n; uint seed; } pc;

void main() {
    const uint tiles_x = pc.n / kN;
    const uint tiles = tiles_x * (pc.n / kM);
    const uint first = gl_WorkGroupID.x * kTilesPerGroup;
    const uint last = min(first + kTilesPerGroup, tiles);

    for (uint t = first + gl_SubgroupID; t < last; t += gl_NumSubgroups) {
        const uint tile_row = (t / tiles_x) * kM;
        const uint tile_col = (t % tiles_x) * kN;

        coopmat<float, gl_ScopeSubgroup, kM, kN, gl_MatrixUseAccumulator> acc =
            coopmat<float, gl_ScopeSubgroup, kM, kN, gl_MatrixUseAccumulator>(0.0);

        for (uint k = 0u; k < pc.n; k += kK) {
            coopmat<float16_t, gl_ScopeSubgroup, kM, kK, gl_MatrixUseA> ma;
            coopmat<float16_t, gl_ScopeSubgroup, kK, kN, gl_MatrixUseB> mb;
            coopMatLoad(ma, a, tile_row * pc.n + k, pc.n, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb, b, k * pc.n + tile_col, pc.n, gl_CooperativeMatrixLayoutRowMajor);
            acc = coopMatMulAdd(ma, mb, acc);
        }

        coopMatStore(acc, c, tile_row * pc.n + tile_col, pc.n, gl_CooperativeMatrixLayoutRowMajor);
    }
}
